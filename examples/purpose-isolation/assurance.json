      "statement": {
        "formal": {
          "language": "ual",
          "source": "∀ (ctx : CardanoLedgerApi.V3.ScriptContext),\n  (match ctx.scriptContextScriptInfo with\n    | .SpendingScript _ _ => True\n    | .MintingScript _ => False\n    | .RewardingScript _ => False\n    | .CertifyingScript _ _ => False\n    | .VotingScript _ => False\n    | .ProposingScript _ _ => False) ∨\n  PlutusCore.UPLC.Utils.isUnsuccessful («spendingOnly» (CardanoLedgerApi.IsData.Class.toLedgerData ctx))"
        },
        "text": "The compiled script rejects every purpose outside {spend}."
      }
    },
