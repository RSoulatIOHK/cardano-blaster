      "statement": {
        "formal": {
          "language": "ual",
          "source": "∀ (ctx : CardanoLedgerApi.V3.ScriptContext),\n  ¬ PlutusCore.UPLC.Utils.isSuccessful («uncheckedPurpose» (CardanoLedgerApi.IsData.Class.toLedgerData ctx))"
        },
        "text": "The compiled script succeeds for some typed script context."
